# MikroTik RouterOS HTTP REST API
MIKROTIK_USER='admin'
MIKROTIK_PASS='your_router_password'
MIKROTIK_TUNNEL_IP='10.200.0.2'
MIKROTIK_PORT=80              # RouterOS HTTP www service port (default: 80)
# MIKROTIK_PORT=8728

# Messaging
ENABLE_WHATSAPP=false
ENABLE_TELEGRAM=true
TELEGRAM_TOKEN='your_telegram_bot_token'
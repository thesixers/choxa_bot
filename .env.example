NODE_ENV=development
PORT=3003

# Branding & ISP Details
ISP_NAME='CHOXA INTERNET'
HOTSPOT_SSID='CHOXA_NET'
PORTAL_URL='choxa.wifi'
SUPPORT_PHONE='07068380792'
TELEGRAM_BOT_HANDLE=''
ADMIN_PHONE='2347068380792'

# Database
PGUSER=postgres
PGHOST=127.0.0.1
PGDATABASE=starlink_auto
PGPASSWORD=your_db_password
PGPORT=5432

# Flutterwave
FLW_SECRET_KEY='FLWSECK_TEST-xxxx'
FLW_SECRET_HASH='your_webhook_secret_hash'
FLW_BASE_URL='https://api.flutterwave.com/v3'
